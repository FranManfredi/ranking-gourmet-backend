# Vercel project: ranking-gourmet-backend
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_BASE_URL=https://api.ranking-gourmet.example.com
FRONTEND_URL=https://ranking-gourmet.example.com
NODE_ENV=production

# Optional. Use only once when bootstrapping the first admin user.
INITIAL_USER_EMAIL=admin@example.com
INITIAL_USER_PASSWORD=replace-with-a-strong-initial-password
INITIAL_USER_NAME=Admin
INITIAL_USER_SURNAME=User
INITIAL_USER_ROLE=admin

# Vercel project: ranking-gourmet-frontend
BACKEND_API_URL=https://api.ranking-gourmet.example.com
BETTER_AUTH_BACKEND_URL=https://api.ranking-gourmet.example.com/api/auth
NEXT_PUBLIC_APP_URL=https://ranking-gourmet.example.com
NEXT_PUBLIC_AUTH_URL=/api/auth
